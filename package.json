{
  "name": "atlas-web",
  "version": "1.1.4",
  "type": "module",
  "main": "./dist/atlas.js",
  "module": "./dist/atlas.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/atlas.d.ts",
      "import": "./dist/atlas.js"
    },
    "./dom": {
      "types": "./dist/atlas-dom.d.ts",
      "import": "./dist/atlas-dom.js"
    },
    "./router": {
      "types": "./dist/atlas-router.js",
      "import": "./dist/atlas-router.js"
    },
    "./types": {
      "types": "./dist/atlas-types.d.ts"
    }
  },
  "private": false,
  "scripts": {
    "dev": "vite",
    "build": "rm -rf dist && vite build"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "vite": "^8.0.10",
    "vite-plugin-dts": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
