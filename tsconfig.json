{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,

    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",

    "baseUrl": ".",

    "paths": {
      "@/*": ["src/*"],
      "@atlas": ["src/atlas/index.ts"],
      "@atlas-dom": ["src/atlas-dom/index.ts"],
      "@atlas-router": ["src/atlas-router/index.ts"],
      "@shared/*": ["src/shared/*"],
      "@interfaces": ["src/shared/interfaces/index.ts"],
      "@services": ["src/shared/services/index.ts"],
      "@types": ["src/shared/types/index.ts"]
    }
  },

}
